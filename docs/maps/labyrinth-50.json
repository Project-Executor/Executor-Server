  "dialogues": {
    "entity": {
      "start": "e1",
      "nodes": {
        "e1": {
          "speaker": "엔티티",
          "text": "……여기까지 온 집행자는 처음이군.",
          "next": "e2"
        },
        "e2": {
          "speaker": "엔티티",
          "text": "이 미궁은 버려진 코드의 잔해다. 길은 계속 엉키고, 문은 아무에게나 열리지 않지.",
          "choices": [
            {
              "text": "출구는 어디야?",
              "next": "e3"
            },
            {
              "text": "넌 누구지?",
              "next": "e4"
            }
          ]
        },
        "e3": {
          "speaker": "엔티티",
          "text": "서쪽. 파란 문 너머다. 이 열쇠를 가져가라.",
          "next": "e5"
        },
        "e4": {
          "speaker": "엔티티",
          "text": "이름 같은 건 없다. 그저 지켜보는 자… 그래도 너를 돕는 건 손해가 아니겠지.",
          "next": "e3"
        },
        "e5": {
          "speaker": "엔티티",
          "text": "……길을 잃지 마라.",
          "effects": [
            {
              "type": "giveKey",
              "keyId": "blue"
            }
          ]
        }
      }
    }
  },
  "guides": [
    {
      "on": "start",
      "text": "거대한 미궁입니다. M을 누르면 맵 전체를 볼 수 있습니다."
    },
    {
      "on": "start",
      "text": "빨간 열쇠를 찾아 동쪽의 빨간 문을 여십시오."
    }
